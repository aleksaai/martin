# Pflicht
TELEGRAM_BOT_TOKEN=          # von @BotFather
INVITE_CODE=                 # beliebiges Wort, Martin startet den Bot über https://t.me/<bot>?start=<INVITE_CODE>
ANTHROPIC_API_KEY=
DATABASE_URL=                # Railway Postgres: ${{Postgres.DATABASE_URL}}

# Optional
MAX_KM=40                    # Umkreis um Erftstadt für vor Ort/hybrid
MIN_SCORE=6                  # ab dieser Passung wird gemeldet
MAX_PER_RUN=15               # höchstens so viele Meldungen pro Lauf
RUN_HOURS=7,12,17            # Suchzeiten, Berliner Zeit
SCORE_MODEL=claude-haiku-4-5-20251001
LETTER_MODEL=claude-sonnet-5-5
SOURCES_OFF=                 # z.B. workday,ba
